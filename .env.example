# Copy this file to .env and fill in your values

# URL of your ASP.NET Core API (used for dev proxy and API client)
VITE_API_URL=https://localhost:7001

# Formspree endpoint for the contact form (used when no API is configured)
# Get yours at https://formspree.io
VITE_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID
